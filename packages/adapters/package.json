{
  "name": "@unified-product-graph/adapters",
  "version": "0.8.7",
  "description": "Import adapters for the Unified Product Graph: Markdown, Notion, Linear, GitHub, Jira, Dovetail, Vistaly, and 30+ more.",
  "license": "MIT",
  "author": "The Product Creator <hello@theproductcreator.com>",
  "homepage": "https://unifiedproductgraph.org",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./notion-schema-generator": {
      "types": "./dist/adapters/notion-schema-generator.d.ts",
      "import": "./dist/adapters/notion-schema-generator.js"
    },
    "./notion-discovery": {
      "types": "./dist/adapters/notion-discovery.d.ts",
      "import": "./dist/adapters/notion-discovery.js"
    },
    "./sync/notion": {
      "types": "./dist/sync/notion/index.d.ts",
      "import": "./dist/sync/notion/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unified-product-graph/tools.git",
    "directory": "packages/adapters"
  },
  "dependencies": {
    "@linear/sdk": "^5.0.0",
    "@notionhq/client": "^2.3.0",
    "@unified-product-graph/core": "*"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.0"
  },
  "bugs": {
    "url": "https://github.com/unified-product-graph/tools/issues"
  }
}
