{
  "name": "@unified-product-graph/markdown",
  "version": "0.20.2",
  "description": "Parser and utilities for UPG Markdown (.upg.md): graph-aware documents with typed entity references",
  "type": "module",
  "license": "MIT",
  "author": "The Product Creator <hello@theproductcreator.com>",
  "homepage": "https://unifiedproductgraph.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unified-product-graph/tools.git",
    "directory": "packages/markdown"
  },
  "bugs": {
    "url": "https://github.com/unified-product-graph/tools/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/__tests__",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@unified-product-graph/core": "*"
  },
  "peerDependenciesMeta": {
    "@unified-product-graph/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^4.1.0"
  },
  "keywords": [
    "upg",
    "markdown",
    "product-graph",
    "entity-references",
    "graph-aware-documents",
    "open-standard"
  ]
}
